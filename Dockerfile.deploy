# syntax=docker/dockerfile:1.7
#
# Production Dockerfile for SnapBeat inference (Option A — Dockerized CLI).
# Builds a self-contained image with Mapperatorinator v31 base + the fine-tuned
# rhythm-skeleton-mt3 LoRA baked in, so the backend server does not need network
# access to HuggingFace at runtime.
#
# Build:
#   export HF_TOKEN=hf_...   # read scope on lukasnorland/rhythm-skeleton-mt3
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.deploy \
#     --secret id=hf_token,env=HF_TOKEN \
#     -t snapbeat-lora:dev .
#
# Run:
#   docker run --rm --gpus all \
#     -v "$PWD/in:/in:ro" -v "$PWD/out:/out" \
#     snapbeat-lora:dev \
#     audio_path=/in/song.mp3 output_path=/out

FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/hf \
    TRANSFORMERS_CACHE=/opt/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps from requirements.deploy.txt (runtime-only subset of
# requirements.txt). flash-attn is installed separately because it requires
# --no-build-isolation and does not play nicely with a single pip invocation.
COPY requirements.deploy.txt ./
RUN pip install -r requirements.deploy.txt
RUN MAX_JOBS=4 pip install --no-build-isolation flash-attn==2.7.4.post1

COPY . .

# Bake the base model + LoRA into the image. HF_TOKEN is mounted via BuildKit
# secret (tmpfs); it never appears in a layer or `docker history`. required=false
# lets this Dockerfile still build against public repos without a token.
ARG BASE_MODEL=OliBomby/Mapperatorinator-v31
ARG LORA_REPO=lukasnorland/rhythm-skeleton-mt3
RUN --mount=type=secret,id=hf_token,target=/run/secrets/hf_token,required=false \
    HF_TOKEN="$(cat /run/secrets/hf_token 2>/dev/null || true)" \
    python -c "import os; from huggingface_hub import snapshot_download; \
tok = os.environ.get('HF_TOKEN') or None; \
snapshot_download('${BASE_MODEL}', token=tok); \
snapshot_download('${LORA_REPO}', token=tok)"

# Non-root runtime user so bind-mounted /in and /out volumes do not end up
# owned by root on the host. /data is the conventional mount point.
RUN useradd -m -u 10001 runner \
    && mkdir -p /data /in /out \
    && chown -R runner:runner /data /in /out /opt/hf
USER runner

ENTRYPOINT ["python", "snapbeat_inference.py"]
CMD ["--help"]
